# Local workflow config — edit paths for your machine
# Usage (from repo root): source scripts/private_scripts/hpc_scripts/config.env && scripts/public/shared_scripts/run_retrieval_rerank_pipeline.sh
#
# Same parameter names as scripts/public/workflow_config_full.env.
# TOP_K = retrieval depth for all stages (k_eval / topk / cap / candidate_limit).

REPO_ROOT=/work

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=$REPO_ROOT/output/workflow_hpc_test
TRAIN_JSON=$REPO_ROOT/example/dicty_gold_llm_public_train_200.jsonl
TEST_BATCH_JSONS="$REPO_ROOT/example/dicty_gold_llm_public_test_50.jsonl"

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths (local) ----------
BM25_INDEX_PATH=$REPO_ROOT/indexes/dicty_bm25_index
DENSE_INDEX_DIR=$REPO_ROOT/indexes/dicty_medembed_index

# ---------- BM25 ----------
# BM25_QUERY_FIELD=query_text_expansion_long   # query_text | query_text_expansion_synonyms | query_text_expansion_long (used by run_query_field_sweep.sh)
# BM25_JAVA_MEM=8g
BM25_THREADS=4
# BM25_RM3_FEEDBACK_POOL=50
# BM25_RM3_FB_DOCS=20
# BM25_RM3_FB_TERMS=30
# BM25_RM3_LAMBDA=0.6
# BM25_INCLUDE_BASELINE=1
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1
# BM25_SAVE_ZERO_RECALL=1

# ---------- Dense ----------
# DENSE_QUERY_FIELD=query_text   # query_text | query_text_expansion_synonyms | query_text_expansion_long (used by run_query_field_sweep.sh)
DENSE_EF_CAP=2000
# DENSE_DEVICE=cpu
# DENSE_BATCH_SIZE=256

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=4
# HYBRID_K_RRF=100
# HYBRID_W_BM25=1.0
# HYBRID_W_DENSE=1.0

# ---------- Reranker ----------
DOCS_JSONL=$REPO_ROOT/output/cleaned/articles_all_cleaned_abstract.jsonl
RERANK_CANDIDATE_LIMIT=2000
RERANK_MODEL=BAAI/bge-reranker-v2-m3   #cross-encoder/ms-marco-MiniLM-L-12-v2
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=56
RERANK_MODEL_MAX_LENGTH=512

# RERANK_USE_MULTI_GPU=1   # set to 1 to use multiple GPUs
# RERANK_NUM_GPUS=2        # 0 = use all available GPUs
