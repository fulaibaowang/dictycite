# Dictycite pipeline config for Frida HPC — full public retrieval goldset (7a),
# v2 chunked full-text corpus (all available PDFs, screened for extractability).
#
# Differences from config_frida_7a_public_goldset_chunked_fulltext_rerank_default.env:
#   - Full 7a goldset (not example train_200/test_50 subset).
#   - New index paths (..._chunked_v2) so v1 chunked indexes stay around.
#   - Corpus: dicty_fulltext_corpus/v2/corpus.jsonl
#     (10,880 abstracts + 87,028 body chunks from 3,556 PDFs).
#
# Used by:
#   sbatch_pipeline_full_goldset_chunked_fulltext_v2_index_only.sh (index build only)
#   sbatch_pipeline_full_goldset_chunked_fulltext_v2.sh (BGE-m3 rerank)
#   sbatch_pipeline_full_goldset_chunked_fulltext_v2_rerank_gemma.sh
#   sbatch_pipeline_full_goldset_chunked_fulltext_v2_rerank_medcpt.sh

REPO_ROOT=/work

RUN_DOCUMENT=1
RUN_SNIPPET_RRF=0

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=$REPO_ROOT/output/workflow_frida_7a_public_goldset_chunked_v2

# Single JSONL: full public goldset
INPUT_JSONL=$REPO_ROOT/output/dicty_gold_build/7a_dicty_gold_llm_public.jsonl

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths (v2 chunked: abstracts + full-text chunks for 3,556 PMIDs) ----------
BM25_INDEX_PATH=$REPO_ROOT/dicty_simulated_data/indexes/bm25_chunked_v2
DENSE_INDEX_DIR=$REPO_ROOT/dicty_simulated_data/indexes/medembed_chunked_v2

# ---------- BM25 ----------
BM25_DISABLE_RM3=1
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Retrieval Fusion (BM25 + Dense RRF) ----------
RETRIEVAL_FUSION_MODE=default
RETRIEVAL_FUSION_JOBS=8
RETRIEVAL_FUSION_K_RRF=150   # keep previous sbatch behavior (RAG-scripts default lowered to 60)

# ---------- Reranker (default BGE cross-encoder; used only when the full pipeline runs) ----------
DOCS_JSONL=$REPO_ROOT/dicty_fulltext_corpus/v2/corpus.jsonl
RERANK_CANDIDATE_LIMIT=2000

RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=64
RERANK_MODEL_MAX_LENGTH=512

RRF_POOL_TOP_RERANK=300         # top-K from reranker for fusion pool
RRF_POOL_TOP_RETRIEVAL=300      # top-K from retrieval fusion for fusion pool

# ---------- Generation ----------
RUN_GENERATION_DOCUMENT=0
RUN_GENERATION_SNIPPET=0
