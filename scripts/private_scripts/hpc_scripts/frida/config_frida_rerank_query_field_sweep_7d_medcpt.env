# Rerank query-field sweep on Frida — benchmark 7d (full), MedCPT cross-encoder.
# Used by: sbatch_frida_rerank_query_field_sweep_medcpt.sh → run_rerank_query_field_sweep.sh
#
# Outputs: ${WORKFLOW_SWEEP_OUTPUT_DIR}/fixed_long_rerank_sweep/...

REPO_ROOT=/work

RUN_DOCUMENT=1
RUN_SNIPPET_RRF=0

WORKFLOW_OUTPUT_DIR=/shared/workspace/biolab/yun/dicty_output/workflow_baseline_full_run_both_routes_query_expansion_7d_medcpt
WORKFLOW_SWEEP_OUTPUT_DIR=/shared/workspace/biolab/yun/dicty_output/workflow_fixed_long_rerank_sweep_7d_medcpt

# Reuse retrieval only (skip BM25+dense+fusion): directory that *contains* retrieval/ — the fixed_long_rerank_sweep root.
# Example prior run: .../dicty_output/workflow_fixed_long_rerank_sweep_7d/fixed_long_rerank_sweep
#RETRIEVAL_COPY_FROM=/shared/workspace/biolab/yun/dicty_output/workflow_fixed_long_rerank_sweep_7d/fixed_long_rerank_sweep

INPUT_JSONL=$REPO_ROOT/output/dicty_gold_build/7d_dicty_gold_query_expansion_benchmark.jsonl

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

BM25_INDEX_PATH=$REPO_ROOT/indexes/dicty_bm25_index
DENSE_INDEX_DIR=$REPO_ROOT/indexes/dicty_medembed_index

BM25_QUERY_FIELD=query_text_synonym_products
DENSE_QUERY_FIELD=query_text_synonym_products

BM25_DISABLE_RM3=1
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

HYBRID_MODE=default
HYBRID_JOBS=8

# ---------- Reranker (MedCPT — Hugging Face cross-encoder) ----------
DOCS_JSONL=$REPO_ROOT/output/dicty_gold_build/7c_articles_cleaned_abstract.jsonl
RERANK_CANDIDATE_LIMIT=1000

RERANK_MODEL=ncbi/MedCPT-Cross-Encoder
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=32
RERANK_MODEL_MAX_LENGTH=512

RUN_GENERATION_DOCUMENT=0
RUN_GENERATION_SNIPPET=0
