# Full-text v3 comparison — 7d (syn) — abstracts + v3 full-text chunks — MedCPT.
# Every arm shares retrieval/rerank settings; only corpus, query field and reranker change.
# Fusion is fixed at RRF k=60 with equal weights (what the paper's sweeps picked), candidate limit
# 2000 and post-rerank pools R300/H300 (the v2 full-text settings), for both corpora.
# Submit: ~/hpc-tools/scripts/hpc_submit.sh scripts/private_scripts/hpc_scripts/frida/sbatch_pipeline_fulltext_v3.sh <this config>

TRACK=dictycite
SUBSET=7d
STAGE=fulltext_v3
TAG=syn_v3_medcpt

REPO=$HOME/dictycite_fulltext_v3
WORKSPACE=/shared/workspace/biolab/yun
CONTAINER_IMG=/shared/home/yun.wang/biolab/yun/bioasq_08.03.26b200.sqfs
OUT_DIR=/data/dicty_output/workflow_frida_fulltext_v3_7d_syn_v3_medcpt
MANIFEST_VARS="BM25_INDEX_PATH DENSE_INDEX_DIR BM25_QUERY_FIELD DENSE_QUERY_FIELD RERANK_QUERY_FIELD RETRIEVAL_FUSION_K_RRF RETRIEVAL_COPY_FROM RRF_POOL_TOP_RERANK RRF_POOL_TOP_RETRIEVAL"

REPO_ROOT=/work
WORKFLOW_OUTPUT_DIR=$OUT_DIR
INPUT_JSONL=$REPO_ROOT/output/dicty_gold_build/7d_dicty_gold_query_expansion_benchmark.jsonl
RUN_DOCUMENT=1
RUN_SNIPPET_RRF=0

# Same candidates as the BGE-m3 run of this arm: reuse its retrieval/ (chain after it).
RETRIEVAL_COPY_FROM=/data/dicty_output/workflow_frida_fulltext_v3_7d_syn_v3_bge

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

BM25_INDEX_PATH=$REPO_ROOT/dicty_simulated_data/indexes/bm25_chunked_v3
DENSE_INDEX_DIR=$REPO_ROOT/dicty_simulated_data/indexes/medembed_chunked_v3
DOCS_JSONL=$REPO_ROOT/dicty_simulated_data/corpus_v3/corpus.jsonl

# Gene-aware query expansion, end to end: retrieval and rerank both use the expanded query.
BM25_QUERY_FIELD=query_text_expansion_synonyms
DENSE_QUERY_FIELD=query_text_expansion_synonyms
RERANK_QUERY_FIELD=query_text_expansion_synonyms

BM25_DISABLE_RM3=1
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

RETRIEVAL_FUSION_MODE=default
RETRIEVAL_FUSION_K_RRF=60
RETRIEVAL_FUSION_W_BM25=1.0
RETRIEVAL_FUSION_W_DENSE=1.0
RETRIEVAL_FUSION_JOBS=8

RERANK_CANDIDATE_LIMIT=2000
RERANK_MODEL=ncbi/MedCPT-Cross-Encoder
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=32
RERANK_MODEL_MAX_LENGTH=512

RRF_POOL_TOP_RERANK=300
RRF_POOL_TOP_RETRIEVAL=300

RUN_GENERATION_DOCUMENT=0
RUN_GENERATION_SNIPPET=0

# A cross-encoder needs well under 24G; the 80G class is for speed (v2's BGE-m3 rerank took ~10 h
# on an A100 40G). Override at submit under queue pressure: GRES=gpu:L4:1 hpc_submit.sh ...
PARTITION=${PARTITION:-frida}
GRES=${GRES:-gpu:A100_80GB:1}
TIME=36:00:00
CPUS=8
MEM=128G
