# Frida — full 7a public goldset, v2 chunked full-text indexes/corpus, BGE Gemma LLM reranker.
# Used by: sbatch_pipeline_full_goldset_chunked_fulltext_v2_rerank_gemma.sh
#
# Same BM25/dense/corpus as config_frida_7a_public_goldset_chunked_fulltext_v2.env;
# swaps cross-encoder for FlagLLMReranker (see config_frida_7a_public_goldset_rerank_gemma.env).

REPO_ROOT=/work

RUN_DOCUMENT=1
RUN_SNIPPET_RRF=0

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=$REPO_ROOT/output/workflow_frida_7a_public_goldset_chunked_v2_rerank_gemma

# After workflow_frida_7a_public_goldset_chunked_v2 (same indexes/INPUT) has finished:
RETRIEVAL_COPY_FROM=$REPO_ROOT/output/workflow_frida_7a_public_goldset_chunked_v2

INPUT_JSONL=$REPO_ROOT/output/dicty_gold_build/7a_dicty_gold_llm_public.jsonl

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths (v2 chunked) ----------
BM25_INDEX_PATH=$REPO_ROOT/dicty_simulated_data/indexes/bm25_chunked_v2
DENSE_INDEX_DIR=$REPO_ROOT/dicty_simulated_data/indexes/medembed_chunked_v2

# ---------- BM25 ----------
BM25_DISABLE_RM3=1
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=8

# ---------- Reranker (Gemma / LLM backend) ----------
DOCS_JSONL=$REPO_ROOT/dicty_fulltext_corpus/v2/corpus.jsonl
RERANK_CANDIDATE_LIMIT=2000

RERANK_MODEL=BAAI/bge-reranker-v2-gemma
RERANK_RERANKER_TYPE=llm
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=48
RERANK_MODEL_MAX_LENGTH=512
RERANK_LLM_USE_FP16=1
RERANK_LLM_USE_BF16=0
RERANK_USE_MULTI_GPU=1
RERANK_NUM_GPUS=3

RRF_POOL_TOP_RERANK=300
RRF_POOL_TOP_RETRIEVAL=300

# ---------- Generation ----------
RUN_GENERATION_DOCUMENT=0
RUN_GENERATION_SNIPPET=0
