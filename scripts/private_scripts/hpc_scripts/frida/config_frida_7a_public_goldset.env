# Dictycite pipeline config for Frida HPC — full public retrieval goldset (7a).
# Built by notebooks/export; see docs/DATA_PREP.md (~1,656 queries).
# Used by: sbatch_pipeline_full_goldset.sh
#
# For the small example train/test subset only, use fulltest/config_full.env + fulltest/sbatch_pipeline_full.sh
# (or the chunked Frida example: config_frida_7a_public_goldset_chunked_fulltext_rerank_default.env).

REPO_ROOT=/work

RUN_DOCUMENT=1
RUN_SNIPPET_RRF=1

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=$REPO_ROOT/output/workflow_frida_7a_public_goldset_both_routes

# Single JSONL: full public goldset (no separate train/test files in this run)
INPUT_JSONL=$REPO_ROOT/output/dicty_gold_build/7a_dicty_gold_llm_public.jsonl

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths (single index each) ----------
BM25_INDEX_PATH=$REPO_ROOT/indexes/dicty_bm25_index
DENSE_INDEX_DIR=$REPO_ROOT/indexes/dicty_medembed_index

# ---------- BM25 ----------
BM25_DISABLE_RM3=1
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Retrieval Fusion (BM25 + Dense RRF) ----------
RETRIEVAL_FUSION_MODE=default
RETRIEVAL_FUSION_JOBS=8
RETRIEVAL_FUSION_K_RRF=150   # keep previous sbatch behavior (RAG-scripts default lowered to 60)

# ---------- Reranker ----------
DOCS_JSONL=$REPO_ROOT/output/dicty_gold_build/7c_articles_cleaned_abstract.jsonl
RERANK_CANDIDATE_LIMIT=1000
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=80
RERANK_MODEL_MAX_LENGTH=512

# ---------- Generation ----------
RUN_GENERATION_DOCUMENT=0
RUN_GENERATION_SNIPPET=0
