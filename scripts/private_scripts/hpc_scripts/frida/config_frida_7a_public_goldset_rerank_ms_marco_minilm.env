# Dictycite pipeline for Frida HPC — full public goldset (7a) with MS MARCO MiniLM cross-encoder reranker.
# Model: https://huggingface.co/cross-encoder/ms-marco-MiniLM-L6-v2
# Used by: sbatch_pipeline_full_goldset_rerank_ms_marco_minilm.sh

REPO_ROOT=/work

RUN_BASELINE=1
RUN_SNIPPET_RRF=1

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=$REPO_ROOT/output/workflow_frida_7a_public_goldset_rerank_ms_marco_minilm

# Seed retrieval/{bm25,dense,fusion} from a finished baseline run (same indexes/corpus) to skip steps 1–3.
# Example after you have e.g. workflow_frida_7a_public_goldset_both_routes completed:
RETRIEVAL_COPY_FROM=$REPO_ROOT/output/workflow_vega_7a_public_goldset_both_routes

INPUT_JSONL=$REPO_ROOT/output/dicty_gold_build/7a_dicty_gold_llm_public.jsonl

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths (single index each) ----------
BM25_INDEX_PATH=$REPO_ROOT/indexes/dicty_bm25_index
DENSE_INDEX_DIR=$REPO_ROOT/indexes/dicty_medembed_index

# ---------- BM25 ----------
BM25_DISABLE_RM3=1
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=8

# ---------- Reranker (MS MARCO MiniLM — Hugging Face cross-encoder) ----------
DOCS_JSONL=$REPO_ROOT/output/dicty_gold_build/7c_articles_cleaned_abstract.jsonl
RERANK_CANDIDATE_LIMIT=1000

RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_MODEL_DEVICE=cuda
# Small model; increase if VRAM allows
RERANK_MODEL_BATCH=64
RERANK_MODEL_MAX_LENGTH=512

# ---------- Generation ----------
RUN_GENERATION_BASELINE=0
RUN_GENERATION_SNIPPET=0
