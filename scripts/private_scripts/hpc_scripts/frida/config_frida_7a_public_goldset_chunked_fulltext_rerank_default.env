# Dictycite pipeline for Frida HPC — example stratified subset (train 200 / test 50 under example/)
# with default cross-encoder reranker (BAAI/bge-reranker-v2-m3, same as workflow_config_baseline.env).
# Chunked BM25 + MedEmbed indexes and full-text corpus.jsonl.
# Used by: sbatch_pipeline_full_goldset_chunked_fulltext_rerank_default.sh

REPO_ROOT=/work

RUN_BASELINE=1
RUN_SNIPPET_RRF=1

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=$REPO_ROOT/output/workflow_frida_example_abstract

# Optional: copy retrieval/{bm25,dense,fusion} from a finished run that used the **same**
# BM25_INDEX_PATH, DENSE_INDEX_DIR, DOCS_JSONL, and INPUT_JSONL. Leave unset for a full run.
# RETRIEVAL_COPY_FROM=$REPO_ROOT/output/some_prior_matching_run

INPUT_JSONL=$REPO_ROOT/example/dicty_gold_llm_public_train_200.jsonl
INPUT_BATCH_JSONLS="$REPO_ROOT/example/dicty_gold_llm_public_test_50.jsonl"

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths (chunked simulated-data build) ----------
BM25_INDEX_PATH=$REPO_ROOT/dicty_simulated_data/indexes/bm25_chunked
DENSE_INDEX_DIR=$REPO_ROOT/dicty_simulated_data/indexes/medembed_chunked

# ---------- BM25 ----------
BM25_DISABLE_RM3=1
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=8

# ---------- Reranker (default BGE cross-encoder) ----------
DOCS_JSONL=$REPO_ROOT/dicty_fulltext_corpus/corpus.jsonl
RERANK_CANDIDATE_LIMIT=2000

RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_DEVICE=cuda
# Omit RERANK_MODEL_BATCH to use pipeline default (16); raise if VRAM allows.

# ---------- Generation ----------
RUN_GENERATION_BASELINE=0
RUN_GENERATION_SNIPPET=0
