# Full pipeline config for dictycite (single BM25 + single dense index, no shards).
# Usage: sbatch_pipeline_full.sh (sources this and runs run_retrieval_rerank_pipeline.sh).

REPO_ROOT=/work

# ---------- Ground truth (eval metrics) ----------
# HAVE_GROUND_TRUTH=1   # set to 0 to skip all eval metrics (BM25, Dense, Hybrid, Rerank)

RUN_BASELINE=1          # build baseline evidence/generation (default: 1)
RUN_SNIPPET_RRF=1       # run snippet-rrf route (steps 6–7, evidence_snippet/, generation_snippet/)

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=$REPO_ROOT/output/workflow_baseline_full_run_both_routes_query_expansion
TRAIN_JSON=$REPO_ROOT/example/dicty_gold_llm_public_train_200.json
TEST_BATCH_JSONS="$REPO_ROOT/example/dicty_gold_llm_public_test_50.json"

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths (single index each) ----------
BM25_INDEX_PATH=$REPO_ROOT/indexes/dicty_bm25_index
DENSE_INDEX_DIR=$REPO_ROOT/indexes/dicty_medembed_index

# ---------- Query fields (body | body_expansion_synonyms | body_expansion_long) ----------
# Retrieval: which question field to use for BM25 and Dense. Reranker: which field to use when scoring candidates.
BM25_QUERY_FIELD=body_expansion_long
DENSE_QUERY_FIELD=body_expansion_long
RERANK_QUERY_FIELD=body_expansion_synonyms

# ---------- BM25 ----------
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Dense ----------
# DENSE_EF_CAP=5000
# DENSE_DEVICE=cuda
# DENSE_BATCH_SIZE=256

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=8

# ---------- Reranker ----------
DOCS_JSONL=$REPO_ROOT/output/cleaned/articles_all_cleaned_abstract.jsonl
RERANK_CANDIDATE_LIMIT=1000
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=64
RERANK_MODEL_MAX_LENGTH=512
# RERANK_USE_MULTI_GPU=1
# RERANK_NUM_GPUS=3

# ---------- Generation (LLM answers from contexts JSON) ----------
# Runs after evidence when evidence/*_contexts.json exist. Writes generation/*_answers.json.
# Requires QUERY_REWRITE_LLM_API_KEY or LLAMA_API_KEY in env or .env.
# Route toggles: set to 0 to skip LLM generation (and rescue) for that route; evidence still built.
RUN_GENERATION_BASELINE=0
RUN_GENERATION_SNIPPET=0
