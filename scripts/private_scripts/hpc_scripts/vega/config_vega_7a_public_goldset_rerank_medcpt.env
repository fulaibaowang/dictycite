# Dictycite pipeline config for VEGA — full public goldset (7a) with MedCPT cross-encoder reranker.
# Used by: sbatch_pipeline_full_goldset_rerank_medcpt.sh

REPO_ROOT=/work

RUN_DOCUMENT=1
RUN_SNIPPET_RRF=1

# ---------- Shared ----------
WORKFLOW_OUTPUT_DIR=/home/wangy/dictycite_output/workflow_vega_7a_public_goldset_rerank_medcpt

# Seed retrieval/{bm25,dense,fusion} from a finished baseline run (same indexes/corpus) to skip steps 1–3.
# Uncomment and set after you have e.g. workflow_vega_7a_public_goldset_both_routes completed:
RETRIEVAL_COPY_FROM=/home/wangy/dictycite_output/workflow_vega_7a_public_goldset_both_routes

INPUT_JSONL=$REPO_ROOT/output/dicty_gold_build/7a_dicty_gold_llm_public.jsonl

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths (single index each) ----------
BM25_INDEX_PATH=$REPO_ROOT/indexes/dicty_bm25_index
DENSE_INDEX_DIR=$REPO_ROOT/indexes/dicty_medembed_index

# ---------- BM25 ----------
BM25_DISABLE_RM3=1
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=8

# ---------- Reranker (MedCPT — Hugging Face cross-encoder) ----------
DOCS_JSONL=$REPO_ROOT/output/dicty_gold_build/7c_articles_cleaned_abstract.jsonl
RERANK_CANDIDATE_LIMIT=1000

RERANK_MODEL=ncbi/MedCPT-Cross-Encoder
RERANK_MODEL_DEVICE=cuda
# Smaller batch than BGE-m3 if VRAM-limited; increase if stable
RERANK_MODEL_BATCH=32
RERANK_MODEL_MAX_LENGTH=512

# ---------- Generation ----------
RUN_GENERATION_DOCUMENT=0
RUN_GENERATION_SNIPPET=0
