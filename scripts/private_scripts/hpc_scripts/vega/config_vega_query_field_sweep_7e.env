# Dictycite 3×3 BM25 × Dense query-field sweep on VEGA — gold benchmark 7e (7d minus abstract_insufficient).
# Used by: sbatch_vega_query_field_sweep.sh
#
# Per-combo outputs: ${WORKFLOW_SWEEP_OUTPUT_DIR}/query_field_sweep/bm25_*_dense_*/

REPO_ROOT=/work

RUN_DOCUMENT=1
RUN_SNIPPET_RRF=0

WORKFLOW_SWEEP_OUTPUT_DIR=/home/wangy/dictycite_output/workflow_query_field_sweep_no_rm3_7e

INPUT_JSONL=$REPO_ROOT/output/dicty_gold_build/7e_dicty_gold_query_expansion_benchmark.jsonl

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

BM25_QUERY_FIELD=query_text
DENSE_QUERY_FIELD=query_text
RERANK_QUERY_FIELD=query_text

BM25_INDEX_PATH=$REPO_ROOT/indexes/dicty_bm25_index
DENSE_INDEX_DIR=$REPO_ROOT/indexes/dicty_medembed_index

BM25_DISABLE_RM3=1
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

HYBRID_MODE=default
HYBRID_JOBS=8
