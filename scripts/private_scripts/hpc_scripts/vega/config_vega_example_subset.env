# Dictycite pipeline config for VEGA (Apptainer + paths under /work and mounted home).
# Small stratified subset (train 200 / test 50) for fast validation — NOT the full public goldset.
# Used by: sbatch_pipeline.sh
#
# Full public goldset (7a, ~1.6k queries): config_vega_7a_public_goldset.env + sbatch_pipeline_full_goldset.sh
#
# Adjust WORKFLOW_OUTPUT_DIR if your Vega home mount differs from /home/wangy inside the container.

REPO_ROOT=/work

# ---------- Ground truth (eval metrics) ----------
# HAVE_GROUND_TRUTH=1   # set to 0 to skip all eval metrics

RUN_DOCUMENT=1
RUN_SNIPPET_RRF=1

# ---------- Shared ----------
# Keep large run artifacts on the Vega home mount (see sbatch script HOME_HOST).
WORKFLOW_OUTPUT_DIR=/home/wangy/dictycite_output/workflow_baseline_full_run_both_routes_query_expansion
TRAIN_JSON=$REPO_ROOT/example/dicty_gold_llm_public_train_200.jsonl
TEST_BATCH_JSONS="$REPO_ROOT/example/dicty_gold_llm_public_test_50.jsonl"

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

# ---------- Index paths (single index each) ----------
BM25_INDEX_PATH=$REPO_ROOT/indexes/dicty_bm25_index
DENSE_INDEX_DIR=$REPO_ROOT/indexes/dicty_medembed_index

# ---------- Query fields (query_text | query_text_expansion_synonyms | query_text_synonym_products) ----------
#BM25_QUERY_FIELD=query_text_synonym_products
#DENSE_QUERY_FIELD=query_text_synonym_products
#RERANK_QUERY_FIELD=query_text_expansion_synonyms

# ---------- BM25 ----------
BM25_DISABLE_RM3=1
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Dense ----------
# DENSE_EF_CAP=5000
# DENSE_DEVICE=cuda
# DENSE_BATCH_SIZE=256

# ---------- Hybrid ----------
HYBRID_MODE=default
HYBRID_JOBS=8

# ---------- Reranker ----------
DOCS_JSONL=$REPO_ROOT/output/dicty_gold_build/7c_articles_cleaned_abstract.jsonl
RERANK_CANDIDATE_LIMIT=1000
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=64
RERANK_MODEL_MAX_LENGTH=512

# ---------- Generation ----------
RUN_GENERATION_DOCUMENT=0
RUN_GENERATION_SNIPPET=0
