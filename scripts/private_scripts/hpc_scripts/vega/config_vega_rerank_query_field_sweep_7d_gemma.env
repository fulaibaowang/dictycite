# Rerank query-field sweep on VEGA — benchmark 7d (full), BGE Gemma (FlagLLMReranker / --reranker-type llm).
# Used by: sbatch_vega_rerank_query_field_sweep_7d_gemma_{body,synonyms,long}.sh → run_rerank_query_field_sweep.sh
#
# Parallel triple Slurm jobs (body / synonyms / long): no --dependency needed if you copy retrieval once
# into this run's fixed_long_rerank_sweep/retrieval/ before submitting, then set:
RETRIEVAL_SKIP_IF_PRESENT=1
#
# Alternative: leave RETRIEVAL_SKIP_IF_PRESENT unset and use RETRIEVAL_COPY_FROM (same dir for all jobs is OK
# only if jobs do not run concurrently — each job does rm -rf retrieval then cp). Example source:
#   RETRIEVAL_COPY_FROM=/home/wangy/dictycite_output/workflow_fixed_long_rerank_sweep_7d/fixed_long_rerank_sweep
#
# Outputs: ${WORKFLOW_SWEEP_OUTPUT_DIR}/fixed_long_rerank_sweep/...

REPO_ROOT=/work

RUN_BASELINE=1
RUN_SNIPPET_RRF=0

WORKFLOW_OUTPUT_DIR=/home/wangy/dictycite_output/workflow_baseline_full_run_both_routes_query_expansion_7d_gemma
WORKFLOW_SWEEP_OUTPUT_DIR=/home/wangy/dictycite_output/workflow_fixed_long_rerank_sweep_7d_gemma

INPUT_JSONL=$REPO_ROOT/output/dicty_gold_build/7d_dicty_gold_query_expansion_benchmark.jsonl

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

BM25_INDEX_PATH=$REPO_ROOT/indexes/dicty_bm25_index
DENSE_INDEX_DIR=$REPO_ROOT/indexes/dicty_medembed_index

BM25_QUERY_FIELD=query_text_synonym_products
DENSE_QUERY_FIELD=query_text_synonym_products

BM25_DISABLE_RM3=1
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

HYBRID_MODE=default
HYBRID_JOBS=8

DOCS_JSONL=$REPO_ROOT/output/dicty_gold_build/7c_articles_cleaned_abstract.jsonl
RERANK_CANDIDATE_LIMIT=1000

RERANK_MODEL=BAAI/bge-reranker-v2-gemma
RERANK_RERANKER_TYPE=llm
RERANK_MODEL_DEVICE=cuda
RERANK_MODEL_BATCH=8
RERANK_MODEL_MAX_LENGTH=512
RERANK_LLM_USE_FP16=1
RERANK_LLM_USE_BF16=0

RUN_GENERATION_BASELINE=0
RUN_GENERATION_SNIPPET=0
