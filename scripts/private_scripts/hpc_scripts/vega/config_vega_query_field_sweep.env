# Dictycite 3×3 BM25 × Dense query-field sweep on VEGA (no rerank; stops at hybrid).
# Used by: sbatch_vega_query_field_sweep.sh
#
# Per-combo outputs: ${WORKFLOW_SWEEP_OUTPUT_DIR}/query_field_sweep/bm25_*_dense_*/
# RM3 is off so BM25 matches the plain-BM25 run names expected by fusion (--bm25-method BM25).

REPO_ROOT=/work

RUN_BASELINE=1
RUN_SNIPPET_RRF=0

# ---------- Sweep root (9 subdirs under .../query_field_sweep/) ----------
WORKFLOW_SWEEP_OUTPUT_DIR=/home/wangy/dictycite_output/workflow_query_field_sweep_no_rm3

# ---------- Ground truth (eval metrics) ----------
# HAVE_GROUND_TRUTH=1

# ---------- Shared (query fields overridden per combo by run_query_field_sweep.sh) ----------
TRAIN_JSON=$REPO_ROOT/example/dicty_gold_llm_public_train_200.jsonl
TEST_BATCH_JSONS="$REPO_ROOT/example/dicty_gold_llm_public_test_50.jsonl"

TOP_K=5000
RECALL_KS=50,100,200,300,400,500,1000,2000,5000

BM25_QUERY_FIELD=query_text
DENSE_QUERY_FIELD=query_text
RERANK_QUERY_FIELD=query_text

# ---------- Index paths ----------
BM25_INDEX_PATH=$REPO_ROOT/indexes/dicty_bm25_index
DENSE_INDEX_DIR=$REPO_ROOT/indexes/dicty_medembed_index

# ---------- BM25 (plain BM25; fusion expects BM25 method tag when RM3 disabled) ----------
BM25_DISABLE_RM3=1
BM25_THREADS=8
BM25_SAVE_RUNS=1
BM25_SAVE_PER_QUERY=1

# ---------- Dense ----------
# DENSE_DEVICE=cuda
# DENSE_BATCH_SIZE=256

# ---------- Hybrid / fusion naming ----------
HYBRID_MODE=default
HYBRID_JOBS=8

# Rerank skipped by sweep (--no-rerank); set if you reuse this env for a full pipeline run:
# DOCS_JSONL=$REPO_ROOT/output/dicty_gold_build/7c_articles_cleaned_abstract.jsonl
